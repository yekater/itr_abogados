---
// Компетенции идут в обычном потоке после программы: описание не скрывается
// за вторым accordion/dislosure и доступно на touch, keyboard и reduced motion.
import {Picture} from 'astro:assets';
import overview from '../assets/competencies/competency-overview.jpg';
import companies from '../assets/competencies/competency-companies.jpg';
import identities from '../assets/competencies/competency-identities.jpg';
import search from '../assets/competencies/competency-search.jpg';
import reports from '../assets/competencies/competency-reports.jpg';
import {duration, durationNote} from '../data/site';

const {locale='es'} = Astro.props;
const es = {
  cards: [
    {
      id: 'overview',
      image: overview,
      title: 'Formación en técnicas de investigación digital',
      description: `Formación online dirigida a abogados, profesionales del derecho digital e investigadores. Aprende a buscar y analizar información, investigar personas y empresas, localizar en redes sociales, utilizar herramientas especializadas y analizar y documentar. ${duration} ${durationNote}`,
      wide: true,
      position: 'itr-pos-overview',
    },
    {
      id: 'companies',
      image: companies,
      title: 'Investigación de empresas y sociedades en fuentes abiertas',
      description: 'Para abogados mercantiles, despachos jurídicos y consultores antifraude: consulta de registros públicos, directorios empresariales y herramientas digitales para recopilar y analizar datos.',
      wide: false,
      position: 'itr-pos-companies',
    },
    {
      id: 'identities',
      image: identities,
      title: 'Investigación de identidades digitales y redes sociales',
      description: 'Búsquedas avanzadas, análisis de perfiles públicos y verificación de fuentes. Una metodología estructurada que prioriza la fiabilidad y el respeto a la privacidad.',
      wide: false,
      position: 'itr-pos-identities',
    },
    {
      id: 'search',
      image: search,
      title: 'Búsqueda avanzada de información en internet',
      description: 'Operadores, localización de documentos y selección de fuentes fiables para profesionales jurídicos, consultores e investigadores.',
      wide: false,
      position: 'itr-pos-search',
    },
    {
      id: 'reports',
      image: reports,
      title: 'Elaboración y documentación de informes de investigación',
      description: 'Recopilación de evidencias digitales e informes claros, estructurados y trazables, sin garantizar por sí mismos su validez judicial.',
      wide: false,
      position: 'itr-pos-reports',
    },
  ] as const,
};
const ca = {
  cards: [
    {
      id: 'overview',
      image: overview,
      title: 'Formació en tècniques d’investigació digital',
      description: `Formació en línia de càrrega estimada de 30 hores dirigida a advocats, professionals del dret digital i investigadors. Aprèn a cercar i analitzar informació, investigar persones i empreses, localitzar a xarxes socials, utilitzar eines especialitzades i analitzar i documentar.`,
      wide: true,
      position: 'itr-pos-overview',
    },
    {
      id: 'companies',
      image: companies,
      title: 'Investigació d’empreses i societats en fonts obertes',
      description: 'Per a advocats mercantils, despatxos jurídics i consultors antifrau: consulta de registres públics, directoris empresarials i eines digitals per recollir i analitzar dades.',
      wide: false,
      position: 'itr-pos-companies',
    },
    {
      id: 'identities',
      image: identities,
      title: 'Investigació d’identitats digitals i xarxes socials',
      description: 'Cerques avançades, anàlisi de perfils públics i verificació de fonts. Una metodologia estructurada que prioritza la fiabilitat i el respecte a la privacitat.',
      wide: false,
      position: 'itr-pos-identities',
    },
    {
      id: 'search',
      image: search,
      title: 'Cerca avançada d’informació a internet',
      description: 'Operadors, localització de documents i selecció de fonts fiables per a professionals jurídics, consultors i investigadors.',
      wide: false,
      position: 'itr-pos-search',
    },
    {
      id: 'reports',
      image: reports,
      title: 'Elaboració i documentació d’informes d’investigació',
      description: 'Recollida d’evidències digitals i informes clars, estructurats i traçables, sense garantir per si mateixos la seva validesa judicial.',
      wide: false,
      position: 'itr-pos-reports',
    },
  ] as const,
};
const en = {
  cards: [
    {
      id: 'overview',
      image: overview,
      title: 'Training in digital investigation techniques',
      description: `Online training with an estimated 30-hour study load for lawyers, digital law professionals and investigators. Learn to find and analyse information, investigate people and companies, locate information on social media, use specialist tools, and analyse and document.`,
      wide: true,
      position: 'itr-pos-overview',
    },
    {
      id: 'companies',
      image: companies,
      title: 'Investigating companies and businesses in open sources',
      description: 'For commercial lawyers, law firms and anti-fraud consultants: querying public registers, business directories and digital tools to collect and analyse data.',
      wide: false,
      position: 'itr-pos-companies',
    },
    {
      id: 'identities',
      image: identities,
      title: 'Investigating digital identities and social media',
      description: 'Advanced searches, analysis of public profiles and source verification. A structured methodology that prioritises reliability and respect for privacy.',
      wide: false,
      position: 'itr-pos-identities',
    },
    {
      id: 'search',
      image: search,
      title: 'Advanced information search on the internet',
      description: 'Operators, document location and selection of reliable sources for legal professionals, consultants and investigators.',
      wide: false,
      position: 'itr-pos-search',
    },
    {
      id: 'reports',
      image: reports,
      title: 'Production and documentation of investigation reports',
      description: 'Collection of digital evidence plus clear, structured and traceable reports that do not guarantee their judicial validity by themselves.',
      wide: false,
      position: 'itr-pos-reports',
    },
  ] as const,
};
const variant = locale==='ca'?ca:locale==='en'?en:es;
const cards=variant.cards;
---
<div class="itr-competencies">
  {cards.map(card => (
    <article class:list={['itr-competency', {'itr-competency--wide': card.wide}, card.position]} data-competency={card.id}>
      <Picture src={card.image} alt="" widths={[560, 840, 1120]} sizes="(min-width: 960px) 50vw, 92vw" formats={['webp']} loading="lazy" decoding="async" class="itr-competency__photo"/>
      <div class="itr-competency__shade" aria-hidden="true"></div>
      <div class="itr-competency__glass" aria-hidden="true"></div>
      <div class="itr-competency__content">
        <h3 class="itr-competency__title"><button type="button" class="itr-competency__control" aria-expanded="false" aria-controls={`competency-${card.id}-panel`}><span class="itr-competency__sign" aria-hidden="true"></span><span>{card.title}</span></button></h3>
        <div id={`competency-${card.id}-panel`} class="itr-competency__panel"><p>{card.description}</p></div>
      </div>
    </article>
  ))}
</div>
